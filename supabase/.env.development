# Perfil LOCAL y de CI de `supabase start` (ADR-012, H-005). Se versiona a proposito: solo trae valores
# locales y ficticios, ningun secreto real. `supabase config push` NO lo lee: el despliegue define
# estas variables en el environment `produccion`. Nunca poner estos valores en supabase/.env
# (ese archivo si lo lee `config push`).
RTC_SITE_URL=http://127.0.0.1:5173/reservas/
RTC_REDIRECT_URL=http://127.0.0.1:5173/reservas/
RTC_GOOGLE_CLIENT_ID=local-sin-google
RTC_GOOGLE_SECRET=local-sin-google
# Edge Function enviar-mail contra el Mailpit/Inbucket del stack (alias de red `inbucket`, ADR-005).
GMAIL_USER=local@ejemplo.test
GMAIL_APP_PASSWORD=local-sin-gmail
# Mismo valor de prueba que .env.example y que el Vault de supabase/seed.sql (T01.2).
MAIL_SECRETO=secreto-solo-local-sin-valor
SMTP_HOST=inbucket
SMTP_PORT=1025
SMTP_TLS=false
# CAPTCHA (ADR-016): secreto de PRUEBA publico de Cloudflare Turnstile (documentacion de Cloudflare); siempre pasa.
# No es un secreto: el real vive solo en el panel de Supabase. Su sitekey de prueba es 1x00000000000000000000AA.
RTC_TURNSTILE_SECRET=1x0000000000000000000000000000000AA
