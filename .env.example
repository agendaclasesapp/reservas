# Variables de ReservaTuClase (plan-entornos.md §2). Copiar a `.env.local` (ignorado por git) y completar.
# Regla (SEC-20): aqui no hay secretos. Los secretos van vacios; solo hay valores locales publicos y el
# MAIL_SECRETO de PRUEBA (el mismo de supabase/.env.development y de supabase/seed.sql; solo local y CI).
# El de produccion se genera aparte y se carga a mano (ops/mails.md). `scripts/seguridad/revisar-variables.mjs` lo verifica.

# --- Web (publicas; Vite las incluye en el bundle). Son las unicas VITE_* permitidas (SEC-20) ---
# URL del API: local `supabase status` (API_URL, http://127.0.0.1:54321); produccion https://<ref>.supabase.co
VITE_SUPABASE_URL=
# Clave publicable o anon (nunca la service_role ni la sb_secret_): local `supabase status`; produccion, panel de la API
VITE_SUPABASE_ANON_KEY=
# Ruta base del sitio: `/reservas/` tambien en local (ADR-007, DEC-14); VITE_BASE la cambia solo para otro alojamiento
VITE_BASE=/reservas/
# Clave publica del sitio de Cloudflare Turnstile (CAPTCHA del pedido de codigo, ADR-016). Valor de PRUEBA publico de
# Cloudflare (siempre pasa; solo local y CI). Produccion: la del sitio real, variable del repositorio VITE_TURNSTILE_SITEKEY
VITE_TURNSTILE_SITEKEY=1x00000000000000000000AA

# --- GitHub Actions: variables del repositorio / environment `produccion` (supabase-deploy.yml) ---
# Ref del proyecto Supabase de produccion (publico)
SUPABASE_PROJECT_REF=
# SECRETO de GitHub: token de acceso de la cuenta Supabase
SUPABASE_ACCESS_TOKEN=
# SECRETO de GitHub: contrasena de la base de produccion
SUPABASE_DB_PASSWORD=

# --- Edge Function enviar-mail (secretos de Supabase en produccion; en local salen de supabase/.env.development) ---
# Casilla de Gmail que envia (DEC-15)
GMAIL_USER=
# SECRETO: contrasena de aplicacion de Gmail, sin espacios
GMAIL_APP_PASSWORD=
# SECRETO en produccion (32 bytes aleatorios); valor de PRUEBA local y CI:
MAIL_SECRETO=secreto-solo-local-sin-valor
# SMTP del envio: local y CI usan el Inbucket del stack; produccion smtp.gmail.com, 465, true
SMTP_HOST=inbucket
SMTP_PORT=1025
SMTP_TLS=false

# --- config.toml (Auth): `env()` que resuelve `supabase start` desde supabase/.env.development y
#     `config push` desde las variables del environment `produccion` (ADR-012, H-005, H-022) ---
# URL del sitio y de retorno de Auth; produccion https://agendaclasesapp.github.io/reservas/ (sin 127.0.0.1)
RTC_SITE_URL=
RTC_REDIRECT_URL=
# Client ID de Google OAuth (publico)
RTC_GOOGLE_CLIENT_ID=
# SECRETO de Google OAuth: en produccion queda VACIO en el workflow (el secreto vive en el panel de Auth)
RTC_GOOGLE_SECRET=

# SECRETO de Turnstile: valor de PRUEBA publico de Cloudflare (igual al de supabase/.env.development; solo local y CI).
# En produccion queda VACIO en el workflow: la clave secreta real vive solo en el panel de Supabase (ops/auth.md).
RTC_TURNSTILE_SECRET=1x0000000000000000000000000000000AA
