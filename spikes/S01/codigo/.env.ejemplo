# Plantilla para la prueba local contra Gmail real (S01). NO completar aqui:
# copiarla FUERA del repo (p. ej. ~/s01-gmail.env), completar alli y pasarla con
#   npx --yes supabase@2.121.0 functions serve --env-file ~/s01-gmail.env
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_SECRETO=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_TLS=true
SMTP_TIMEOUT_MS=10000
